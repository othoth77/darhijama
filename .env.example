APP_NAME="Notre Jour"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE="Africa/Tunis"
APP_URL=http://localhost:8000
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=notre_jour
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

# Feature Flags (Laravel Pennant) — stockage en base pour pilotage depuis le back-office.
PENNANT_STORE=database

# Stockage médias — OVH Object Storage (compatible S3).
# ATTENTION (voir AUDIT_PHASE_0.md correctif E) : mettre FILESYSTEM_DISK=s3
# uniquement une fois AWS_* renseignés (staging/production). En local sans
# identifiants OVH, laisser sur "public" pour pouvoir démarrer l'application.
FILESYSTEM_DISK=public
MEDIA_DISK=public
MEDIA_VISIBILITY=public
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=gra
AWS_BUCKET=notre-jour-media
AWS_ENDPOINT=https://s3.gra.io.cloud.ovh.net
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=

# WhatsApp — source unique de vérité pour le numéro et le message préformaté.
WHATSAPP_PHONE_E164=21698999660
WHATSAPP_DEFAULT_MESSAGE="Bonjour Notre Jour, Je souhaite commander une invitation digitale à 49 DT."

# Offre unique du MVP.
OFFER_PRICE_DT=49
OFFER_CURRENCY=DT

# Compte admin créé par database/seeders/DatabaseSeeder.php — à changer
# impérativement avant tout déploiement (voir INSTALL.md).
ADMIN_EMAIL=admin@notrejour.tn
ADMIN_PASSWORD=change-me-immediately

MAIL_MAILER=log
