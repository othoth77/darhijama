{
    "name": "notrejour/notre-jour",
    "type": "project",
    "description": "Notre Jour - Plateforme d'invitations de mariage digitales (architecture SaaS modulaire).",
    "keywords": ["laravel", "wedding", "invitations", "saas", "modular"],
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0",
        "laravel/pennant": "^1.13",
        "laravel/tinker": "^2.9",
        "filament/filament": "^3.3",
        "nwidart/laravel-modules": "^11.1",
        "spatie/laravel-permission": "^6.9",
        "endroid/qr-code": "^5.0",
        "intervention/image": "^3.9",
        "league/flysystem-aws-s3-v3": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/pail": "^1.1",
        "laravel/pint": "^1.13",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^11.0.1",
        "spatie/laravel-ignition": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Applications\\": "Applications/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Mythos\\Core\\": "Mythos/Core/",
            "Modules\\": "Modules/"
        },
        "files": [
            "app/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "lint": "pint",
        "analyse": "phpstan analyse --memory-limit=1G",
        "test": [
            "@php artisan config:clear",
            "@php artisan test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
