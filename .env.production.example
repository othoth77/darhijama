APP_NAME="Mythos OS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Tunis
APP_URL=https://darhijama.tn
DAR_HIJAMA_HOST=darhijama.tn
DAR_HIJAMA_WWW_HOST=www.darhijama.tn
DEPLOYMENT_URL=https://darhijama.tn
DEPLOYMENT_HOSTNAME=darhijama.tn,www.darhijama.tn
DEPLOYMENT_IMAGE_PREFIX=mythos-darhijama-production
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

TRUSTED_HOSTS=darhijama.tn,www.darhijama.tn
# The web container that forwards to PHP-FPM gets its address from Docker's
# default-address-pools (10.0.0.0/8 on this host). If it is not trusted, Laravel
# sees HTTPS requests as http and rejects signed URLs (Livewire uploads: 401).
TRUSTED_PROXIES=10.0.0.0/8

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
MYSQL_DATABASE=darhijama
MYSQL_USER=darhijama
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_ATTR_SSL_CA=

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_ENCRYPT=true

QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids
DB_QUEUE_RETRY_AFTER=120

REDIS_QUEUE_PASSWORD=
REDIS_CACHE_PASSWORD=
REDIS_SESSION_PASSWORD=

FILESYSTEM_DISK=s3
MEDIA_DISK=s3
MEDIA_VISIBILITY=public
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=gra
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

DAR_HIJAMA_NOTIFICATION_CHANNELS=database

# Official Dar Hijama WhatsApp number (00216 98 999 660), E.164 without "+".
WHATSAPP_PHONE_E164=21698999660

ADMIN_EMAIL=
ADMIN_PASSWORD=
